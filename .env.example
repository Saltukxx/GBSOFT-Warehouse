# Kopyalayın: cp .env.example .env
# .env sürüm kontrolüne girmez.

# --- Veritabanı ---
POSTGRES_USER=gbsoft
POSTGRES_PASSWORD=gbsoft_dev
POSTGRES_DB=gbsoft
POSTGRES_PORT=5434
DATABASE_URL=postgresql://gbsoft:gbsoft_dev@localhost:5434/gbsoft?schema=public

# --- API ---
API_PORT=3001
API_HOST=127.0.0.1
LOG_LEVEL=info

# --- Optimizasyon servisi ---
OPTIMIZER_URL=http://127.0.0.1:8001

# Tek kiracı kurulum: varsayılan tenant. Şema baştan tenant-scoped olduğu
# için çok kiracılıya geçiş migration gerektirmez.
DEFAULT_TENANT_ID=gbsoft-pilot

# --- Web ---
# 1 yapılırsa arayüz backend olmadan fixture verisiyle çalışır (satış demosu).
VITE_DEMO_MODE=0
VITE_API_URL=http://127.0.0.1:3001
